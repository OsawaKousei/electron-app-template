{
  "name": "electron-app-template",
  "version": "1.0.0",
  "description": "An Electron app template with React and TypeScript",
  "license": "MIT",
  "author": "",
  "electronmon": {
    "patterns": [
      "dist/**/*"
    ]
  },
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "electron-rebuild",
    "dev": "rimraf dist && run-p dev:webpack dev:electron",
    "dev:webpack": "cross-env NODE_ENV=\"development\" webpack --progress",
    "dev:electron": "wait-on ./dist/index.html ./dist/main.js && electronmon .",
    "build": "cross-env NODE_ENV=\"production\" webpack --progress",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/node": "^22.15.19",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "electron": "^36.2.1",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "electronmon": "^2.0.3",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.3",
    "webpack": "^5.99.8",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "build": {
    "appId": "com.n622.slack-archive-reader",
    "productName": "slack-archive-reader",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "build/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/app_icon.ico"
    }
  }
}
